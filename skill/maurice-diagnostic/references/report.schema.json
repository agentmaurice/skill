{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmaurice.ai/skill/maurice-diagnostic/references/report.schema.json",
  "title": "agentmaurice.fit-diagnostic/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "repository",
    "sources",
    "potential",
    "opportunities",
    "anti_fit",
    "questions"
  ],
  "properties": {
    "schema": {
      "const": "agentmaurice.fit-diagnostic/v1"
    },
    "generated_at": {
      "type": "string",
      "minLength": 10
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "agent_guide_version": {
          "type": "string"
        },
        "mcp_catalog_generated_at": {
          "type": "string"
        },
        "cib_modules_generated_at": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "live",
            "snapshot",
            "mixed"
          ]
        }
      }
    },
    "potential": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "capability",
          "brick",
          "needs",
          "evidence",
          "scores",
          "pilot"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^opp-[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "enum": [
              "compiled_workflow",
              "workflow",
              "agent_mode",
              "channel",
              "miniapp",
              "human_approval",
              "vault",
              "mcp",
              "swarm",
              "organisation",
              "module",
              "connected_service",
              "entry_point"
            ]
          },
          "brick": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "mcp",
                  "module",
                  "connected_service",
                  "none"
                ]
              },
              "ref": {
                "type": "string"
              }
            }
          },
          "needs": {
            "enum": [
              "maurice",
              "console_account",
              "none"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "level"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "level": {
                  "enum": [
                    "proven",
                    "likely"
                  ]
                }
              },
              "if": {
                "properties": {
                  "level": {
                    "const": "proven"
                  }
                }
              },
              "then": {
                "required": [
                  "line"
                ]
              }
            }
          },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "volume",
              "rules",
              "cost",
              "effort",
              "risk"
            ],
            "properties": {
              "volume": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "rules": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "cost": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "effort": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "risk": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              }
            }
          },
          "pilot": {
            "type": "boolean"
          }
        }
      }
    },
    "anti_fit": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "potential": {
            "enum": [
              "high",
              "medium"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "opportunities": {
            "contains": {
              "type": "object",
              "required": [
                "pilot"
              ],
              "properties": {
                "pilot": {
                  "const": true
                }
              }
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      },
      "else": {
        "properties": {
          "opportunities": {
            "contains": {
              "type": "object",
              "required": [
                "pilot"
              ],
              "properties": {
                "pilot": {
                  "const": true
                }
              }
            },
            "minContains": 0,
            "maxContains": 1
          }
        }
      }
    }
  ]
}
